{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "printWidth": 90,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "sortImports": {},
  "sortPackageJson": true,
  "sortTailwindcss": {},
  "ignorePatterns": [
    ".agents",
    ".opencode",
    "*.toml",
    "dist",
    "coverage",
    "node_modules",
    "pnpm-lock.yaml",
    "src-tauri"
  ]
}
