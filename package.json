{
  "name": "GalgameManager",
  "version": "1.3.1",
  "author": "lxl66566",
  "packageManager": "pnpm@10.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "fix": "oxlint --fix . && eslint --fix .",
    "fmt:check": "prettier src -c",
    "fmt": "prettier src -w",
    "lint": "oxlint .",
    "lint:full": "oxlint . && eslint src",
    "check": "tsc --noEmit --strict --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run fmt:check && pnpm run lint:full && pnpm run check && pnpm run test && pnpm run build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,md,yml,yaml}": "prettier --write"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.4.0",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^1.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.2.0",
    "@unocss/preset-wind4": "^66.7.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-solid": "^0.15.0",
    "lightningcss": "1.28.2",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.13.1",
    "solid-icons": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "baseline-browser-mapping": "^2.11.15",
    "caniuse-lite": "^1.0.30001809",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "jiti": "^2.7.0",
    "solid-js": "^1.9.15",
    "solid-toast": "^0.5.0",
    "tailwind-merge": "^3.6.0",
    "unocss-preset-scrollbar-hide": "^1.0.1",
    "virtua": "^0.50.2"
  }
}
