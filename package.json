{
  "name": "GalgameManager",
  "version": "1.4.4",
  "license": "MIT",
  "author": "lxl66566",
  "type": "module",
  "sideEffects": [
    "./src/index.tsx",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "fix": "oxlint --fix . && eslint --fix . && oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt": "oxfmt",
    "lint": "oxlint .",
    "lint:full": "oxlint . && eslint src",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run fmt:check && pnpm run lint:full && pnpm run check && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "baseline-browser-mapping": "^2.11.39",
    "caniuse-lite": "^1.0.30001828",
    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "d3-transition": "^3.0.2",
    "dayjs": "^1.11.23",
    "jiti": "^2.7.0",
    "solid-js": "^1.9.20",
    "solid-toast": "^0.5.0",
    "tailwind-merge": "^3.7.1",
    "unocss-preset-scrollbar-hide": "^1.0.1",
    "virtua": "^0.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lxl66566/eslint-plugin-import-purity": "^0.1.0",
    "@solid-primitives/i18n": "^3.0.1",
    "@solidjs/router": "^1.0.3",
    "@tauri-apps/cli": "^2.12.6",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.11",
    "@unocss/preset-wind4": "^66.13.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-oxlint": "^1.95.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-solid": "^0.20.1",
    "lightningcss": "1.33.0",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "simple-git-hooks": "^2.14.0",
    "solid-icons": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,md,yml,yaml}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix --no-warn-ignored",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.23.0"
}
